# Kopieren nach /etc/inmedi-intake.env und ausfüllen:  sudo cp inmedi-intake.env.example /etc/inmedi-intake.env
# Danach:  sudo chown root:inmedi /etc/inmedi-intake.env && sudo chmod 640 /etc/inmedi-intake.env
# Diese Datei enthält Geheimnisse – niemals ins Repository einchecken.

# --- Microsoft 365 (App-Registrierung in Microsoft Entra, siehe server/README.md Schritt 1) ---
MS_TENANT_ID=00000000-0000-0000-0000-000000000000
MS_CLIENT_ID=00000000-0000-0000-0000-000000000000
MS_CLIENT_SECRET=hier-den-geheimen-Wert-eintragen
MAILBOX=rechnungen@ihre-domain.de

# Ordner im Postfach (werden bei Bedarf angelegt)
SOURCE_FOLDER=inbox
DONE_FOLDER=Rechnungen verarbeitet
CHECK_FOLDER=Rechnungen prüfen

# Abruf alle x Minuten, höchstens n Mails pro Durchlauf
POLL_MINUTES=5
MAX_PER_RUN=50

# --- Zugang für das CRM ---
# Erzeugen mit:  openssl rand -hex 32   (mind. 24 Zeichen) – denselben Wert im CRM unter
# Einstellungen → Rechnungseingang eintragen.
API_TOKEN=
# Nur diese Adresse(n) dürfen die Schnittstelle im Browser aufrufen (CRM-Adresse, kommagetrennt)
ALLOWED_ORIGINS=https://karimemiraa.github.io

# --- Dienst ---
HOST=127.0.0.1
PORT=8787
DATA_DIR=/var/lib/inmedi-intake
